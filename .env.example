# Headwind MDM behind an external HTTPS reverse proxy.
# Copy this file to .env and replace all example values.

SQL_BASE=hmdm
SQL_USER=hmdm
SQL_PASS=change-me-with-a-long-random-password

ADMIN_EMAIL=admin@example.com

# DNS name used by Headwind. BASE_URL is the externally visible URL and may
# use HTTPS while the container itself listens on plain HTTP behind a proxy.
BASE_DOMAIN=mdm.example.com
BASE_URL=https://mdm.example.com

# Persistent runtime data. Keep source/build files wherever convenient and
# point this at a durable host path for database and application state.
HMDM_DATA_ROOT=./volumes

# Optional local host mapping used by the image when the server is behind NAT.
LOCAL_IP=

# Bind the Headwind HTTP listener only to loopback by default.
HMDM_BIND_ADDRESS=127.0.0.1
HMDM_HTTP_PORT=18080

# MQTT is device-facing and remains published unless you deliberately choose
# polling-only operation or proxy MQTT separately.
HMDM_MQTT_PORT=31000

# Explicit Docker network name so this stack remains isolated on shared hosts.
HMDM_NETWORK_NAME=hmdm-backend

# Set true only when intentionally regenerating Headwind configuration files.
FORCE_RECONFIGURE=

# Tomcat transport. For this deployment profile TLS terminates at the external proxy.
PROTOCOL=http

SHARED_SECRET=change-me-with-a-long-random-secret

HMDM_VARIANT=os
DOWNLOAD_CREDENTIALS=
HMDM_URL=https://h-mdm.com/files/hmdm-5.40.1-os.war
CLIENT_VERSION=6.37
